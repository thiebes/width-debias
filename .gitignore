# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Outputs
output/
*.png
*.svg
!docs/**/*.png
!docs/**/*.svg
# Each experiment set keeps its committed figure(s) in its own folder. Track
# those, but not regenerated run outputs.
!experiments/**/*.png
!experiments/**/*.svg
!illustrations/**/*.png
!illustrations/**/*.svg

# LaTeX build artifacts (write-ups are compiled inside their set folder)
experiments/**/*.aux
experiments/**/*.log
experiments/**/*.out
experiments/**/*.fls
experiments/**/*.fdb_latexmk
experiments/**/*.synctex.gz

# Source PDFs / extracted text (local reference only)
sources/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Collaborator data -- never committed. The scripts read it from the data root
# (WIDTH_DEBIAS_DATA_ROOT, or else data/ at the repository root; see
# scripts/data_root.py). Some sets keep a local data/ dir; see each set's
# DATASETS.md.
/data/
mc_experiments/**/data/
experiments/**/data/
# Per-scan outputs derived from unpublished measurements; regenerated locally.
experiments/wse2-strobescat/diagnostics/

# Origin project binaries (raw published-figure data; extracted CSVs are committed)
*.opju
